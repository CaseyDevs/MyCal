@page "/account/accept"
@model MyCal.Web.Pages.Account.AcceptModel
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>Set your password · MyCal</title>
<link rel="stylesheet" href="/app.css">
<script src="/js/theme.js">
</script>
</head>
<body>
<main class="auth-shell">
<a class="brand" href="/">mycal<span>●</span>
</a>
<section class="panel auth-card">
<p class="eyebrow">MAKE YOURSELF AT HOME</p>
<h1>Your fresh start.</h1>
<p class="muted">Choose a password for your invitation or recovery link.</p>
@if (Model.Success) { <div class="notice">Your password is set. <a href="/account/login">Continue to sign in →</a>
</div> }
else { <form method="post">
<div asp-validation-summary="All" class="notice error" role="alert">
</div>
<input asp-for="Token" type="hidden">
<label asp-for="Password">New password</label>
<input asp-for="Password" type="password" autocomplete="new-password" minlength="12" required>
<p class="small muted">At least 12 characters, including upper and lower case, a number, and a symbol.</p>
<label asp-for="ConfirmPassword">Confirm password</label>
<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required>
<button class="button primary wide">Set password</button>
</form> }
</section>
</main>
</body>
</html>
