@inherits TrackerPage
@implements IAsyncDisposable
@inject IFoodSearch FoodSearch
@inject IJSRuntime JS
<div id="@_dialogId" class="sheet-backdrop" @onclick="Close">
<section class="food-sheet" role="dialog" aria-modal="true" aria-labelledby="food-title" @onclick:stopPropagation="true">
    <header class="sheet-header">
<div>
<p class="eyebrow">BUILD YOUR DAY</p>
<h2 id="food-title">Add something good.</h2>
</div>
<button class="icon-button" aria-label="Close food picker" @onclick="Close" disabled="@Busy">
<Icon Name="close" />
</button>
</header>
    <div class="tabs" role="tablist" aria-label="Food source">@foreach (var tab in new[] { "Search", "Recents", "Favourites", "Custom", "Barcode" }) { <button role="tab" aria-selected="@(_tab == tab)" class="@(_tab == tab ? "selected" : "")" @onclick="() => ChangeTab(tab)">@tab</button> }
</div>
    <div class="sheet-body">
    @if (Error is not null) { <div class="notice error" role="alert">@Error</div> }
    @if (_notice is not null) { <div class="notice small">@_notice</div> }
    @if (_tab == "Search")
    {
        <form class="search-box" @onsubmit="Search" @onsubmit:preventDefault="true">
<Icon Name="search" />
<input aria-label="Search foods" placeholder="Search a food or brand…" @bind="_query" maxlength="100" minlength="2" />
<button class="button primary" disabled="@Busy">@(Busy ? "Searching…" : "Search")</button>
</form>
        <p class="muted small">Generic foods from USDA · Packaged foods from Open Food Facts</p>
    }
    @if (_tab == "Barcode")
    {
        <p class="muted">Scan an EAN/UPC barcode, or type its digits below.</p>
        <div class="scanner">
<video id="@_videoId" playsinline muted>
</video>@if (!_scanning) { <button class="button secondary" @onclick="StartScanner">
<Icon Name="scan" />Open camera</button> }
</div>
        @if (_scanning) { <button class="text-button" @onclick="StopScanner">Stop camera</button> }
        <form class="search-box" @onsubmit="LookupBarcode" @onsubmit:preventDefault="true">
<input aria-label="Barcode digits" inputmode="numeric" autocomplete="off" maxlength="13" placeholder="e.g. 5000159484695" @bind="_barcode" />
<button class="button primary" disabled="@Busy">Look up</button>
</form>
    }
    @if (_tab == "Custom")
    {
        <EditForm Model="_custom" OnValidSubmit="SelectCustom">
<DataAnnotationsValidator />
<ValidationSummary class="notice error" />
            <div class="form-grid">
<label class="span-2">Food name<InputText @bind-Value="_custom.Name" placeholder="Your food or meal" />
</label>
<label class="span-2">Brand (optional)<InputText @bind-Value="_custom.Brand" />
</label>
            <label>Reference quantity<InputNumber @bind-Value="_custom.ReferenceQuantity" step="any" />
</label>
<label>Reference unit<InputSelect @bind-Value="_custom.Unit">@foreach (var unit in Enum.GetValues<NutritionUnit>()) { <option value="@unit">@Unit(unit)</option> }
</InputSelect>
</label>
            <label>Calories (kcal)<InputNumber @bind-Value="_custom.Calories" step="any" />
</label>
<label>Protein (g)<InputNumber @bind-Value="_custom.Protein" step="any" />
</label>
<label>Carbohydrate (g)<InputNumber @bind-Value="_custom.Carbohydrates" step="any" />
</label>
<label>Fat (g)<InputNumber @bind-Value="_custom.Fat" step="any" />
</label>
</div>
            <p class="muted small">Enter the values for your reference quantity. Leave unknown macros blank. For UK labels, carbohydrate excludes fibre.</p>
<button class="button secondary" type="submit">Preview portion →</button>
        </EditForm>
    }
    @if (_tab is "Search" or "Recents" or "Favourites")
    {
        @if (_foods.Count == 0) { <div class="empty-mini">
<Icon Name="search" />
<p>@(_tab == "Search" ? "Search to find your next entry." : "Your saved foods will appear here.")</p>
<button class="text-button" @onclick='() => ChangeTab("Custom")'>Create a custom food →</button>
</div> }
        @foreach (var food in _foods) { <button class="food-result" @onclick="() => Select(food)">
<span class="food-avatar">@food.Name[..1].ToUpperInvariant()</span>
<span>
<strong>@food.Name</strong>
<small>@food.Brand · @food.Source</small>
</span>
<span class="result-calories">@Number(food.Calories)<small>kcal / @Number(food.ReferenceQuantity) @(food.RequiresBasisConfirmation ? "g or ml" : Unit(food.Unit))</small>
</span>
<Icon Name="arrow" />
</button> }
    }
    @if (_selected is not null)
    {
        <section class="portion-card">
<div class="section-heading">
<h3>@_selected.Name</h3>
<button class="text-button" @onclick="ToggleFavourite" disabled="@(Busy || (_selected.RequiresBasisConfirmation && !_basisConfirmed))">@(_selected.IsFavourite ? "★ Saved" : "☆ Favourite")</button>
</div>
<p class="small muted">@_selected.Brand · @_selected.Source</p>
        @if (_selected.RequiresBasisConfirmation)
        {
            <div class="notice">
<strong>Check the package label.</strong>
<p>Are these values per 100 g or per 100 ml? Choose the matching unit; these cannot be interchanged.</p>
<label>Nutrition basis<select @bind="_basisUnit">
<option value="@NutritionUnit.Grams">Per 100 g</option>
<option value="@NutritionUnit.Millilitres">Per 100 ml</option>
</select>
</label>
<label class="check">
<input type="checkbox" @bind="_basisConfirmed" />I checked the nutrition basis and values on the package.</label>
</div>
        }
        <div class="form-grid">
<label>Amount (@Unit(EffectiveFood.Unit))<input type="number" step="any" min="0.01" max="100000" @bind="_amount" />
</label>
<label>Meal<select @bind="_meal">@foreach (var meal in Enum.GetValues<Meal>()) { <option value="@meal">@meal</option> }
</select>
</label>
</div>
        @if (_amount > 0 && _amount <= 100000)
        {
            var portion = NutritionMath.Portion(EffectiveFood, _amount);
            <div class="portion-nutrition">
<strong>@Number(portion.Calories)<small> kcal</small>
</strong>
<span>P @Known(EffectiveFood.Protein, portion.Protein)</span>
<span>C @Known(EffectiveFood.Carbohydrates, portion.Carbohydrates)</span>
<span>F @Known(EffectiveFood.Fat, portion.Fat)</span>
</div>
        }
        <button class="button primary wide" disabled="@(Busy || _amount <= 0 || _amount > 100000 || (_selected.RequiresBasisConfirmation && !_basisConfirmed))" @onclick="Add">
<Icon Name="plus" />@(Busy ? "Saving…" : "Add to diary")</button>
</section>
    }
    <p class="source-note">Food data: <a href="https://fdc.nal.usda.gov/" target="_blank" rel="noopener">USDA FoodData Central</a> and <a href="https://world.openfoodfacts.org/" target="_blank" rel="noopener">Open Food Facts</a> (ODbL). Product coverage and accuracy vary; check your package.</p>
    </div>
</section>
</div>
