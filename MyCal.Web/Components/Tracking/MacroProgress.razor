<div class="macro-card @Colour">
    <div class="macro-label">
<span class="dot">
</span>@Label <span class="macro-percent">@(Target > 0 ? (Value / Target).ToString("P0") : "—")</span>
</div>
    <div class="macro-number">@(Partial ? "≥ " : "")@Value.ToString("0.#")<span> / @Target.ToString("0.#") g</span>
</div>
    <div class="progress-track" role="progressbar" aria-label="@Label" aria-valuenow="@Value" aria-valuemin="0" aria-valuemax="@Math.Max(Value, Target)">
<span style="@($"width:{Math.Clamp(Target > 0 ? Value / Target * 100 : 0, 0, 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%")">
</span>
</div>
    <small>@(Partial ? "Some values are unknown" : Value > Target ? $"{(Value - Target):0.#} g over target" : $"{(Target - Value):0.#} g remaining")</small>
</div>
@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Colour { get; set; } = "protein";
    [Parameter] public decimal Value { get; set; }
    [Parameter] public decimal Target { get; set; }
    [Parameter] public bool Partial { get; set; }
}
